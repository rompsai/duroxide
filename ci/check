#!/usr/bin/env bash
# ci/check: one of the five flow scripts (check, test, build, deploy, smoke).
# Wraps today's commands; source: .github/workflows/CI.yml:21 (cargo build --all-features).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Secret scan of this PR's own commits (seconds). The daily 04:00 SGT run scans full history.
base="${FLOW_BASE:-$(git merge-base origin/main HEAD)}"
gitleaks git . --redact --no-banner --exit-code 1 --log-opts="${base}..HEAD"

# Compile, as today's PR job does (no tests).
cargo build --all-features
